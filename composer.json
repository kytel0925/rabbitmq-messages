{
    "name": "sloth-dev-guy/rabbitmq-messages",
    "description": "Idempotent and resilient domain events between bounded contexts for Laravel, transported over RabbitMQ (AMQP 0-9-1).",
    "type": "library",
    "keywords": [
        "sloth-dev-guy",
        "laravel",
        "rabbitmq",
        "amqp",
        "domain-events",
        "outbox",
        "inbox",
        "idempotency",
        "resiliency"
    ],
    "homepage": "https://github.com/sloth-dev-guy/rabbitmq-messages",
    "license": "MIT",
    "authors": [
        {
            "name": "Telmo Rafael",
            "email": "sloth.dev.guy@gmail.com",
            "homepage": "https://sloth-guy.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-sockets": "*",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/pipeline": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "php-amqplib/php-amqplib": "^3.7",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "SlothDevGuy\\RabbitMQMessages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlothDevGuy\\RabbitMQMessagesTests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature",
        "lint": "pint --test",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SlothDevGuy\\RabbitMQMessages\\RabbitMQMessagesServiceProvider"
            ],
            "aliases": {
                "RabbitMQMessage": "SlothDevGuy\\RabbitMQMessages\\RabbitMQMessage"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

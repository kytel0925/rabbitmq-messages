# Development environment (docker compose). Copy to .env.

APP_NAME="RabbitMQ Messages"

# rabbitmq-messages: broker
RABBITMQ_APP_ID="${APP_NAME}"
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=username
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/

# rabbitmq-messages: this bounded context's consumer queue
RABBITMQ_QUEUE=rabbitmq-messages.queue-name

# rabbitmq-messages: resiliency
RABBITMQ_MESSAGES_MAX_TRIES=3
RABBITMQ_RETRY_QUEUE=rabbitmq-messages.queue-name.retry
RABBITMQ_RETRY_QUEUE_DELAY=3000
RABBITMQ_DEAD_LETTER_QUEUE=rabbitmq-messages.queue-name.dead-letter

# rabbitmq-messages: fanout connection ("rabbitmq")
RABBITMQ_EXCHANGE=amq.fanout

# rabbitmq-messages: topic connection ("rabbitmq_topic")
RABBITMQ_TOPIC_EXCHANGE=amq.topic
RABBITMQ_TOPIC_ROUTING_KEY="rabbitmq-messages.#"

#!/usr/bin/env bash
#
# Consumes domain events published by other bounded contexts.
#
# Runs `php artisan queue:work <connection>` against the rabbitmq-messages
# driver. Retries, dead-lettering and idempotency are handled by the library,
# so --tries/--backoff are intentionally not used.

cd "${APP_PATH:-/app}" || exit 1

if test -f .env; then
    set -o allexport
    source .env
    set +o allexport
    echo "environment variables loaded"
fi

CONNECTION="${CONNECTION:-rabbitmq}"
QUEUE_NAME="${RABBITMQ_QUEUE:-default}"
MAX_JOBS="${MAX_JOBS:-30000}"
MAX_MEMORY="${MAX_MEMORY:-128}"
JOB_TIMEOUT="${JOB_TIMEOUT:-300}"
TIMEOUT="${TIMEOUT:-600}"
SLEEP="${SLEEP:-1}"
DAEMON_SLEEP="${DAEMON_SLEEP:-30}"

# declare exchanges, the consumer queue, bindings, retry and dead letter queues
# for every configured connection (idempotent)
php artisan rabbitmq-messages:setup || {
    echo "unable to set up the RabbitMQ topology"
    exit 1
}

echo "Processing messages from the [${QUEUE_NAME}] queue"

set -e
while true; do
    (timeout --preserve-status --foreground "${TIMEOUT}" php artisan queue:work "${CONNECTION}" \
        --name "${QUEUE_NAME}" \
        --queue "${QUEUE_NAME}" \
        --max-jobs "${MAX_JOBS}" \
        --memory "${MAX_MEMORY}" \
        --sleep "${SLEEP}" \
        --timeout "${JOB_TIMEOUT}" \
        --json) || {
            echo "unexpected error exit the daemon"
            exit 1
        }

    echo "$(date '+%Y-%m-%dT%H:%M:%S.%6N%:z') daemon sleep ${DAEMON_SLEEP}"
    sleep "${DAEMON_SLEEP}"
    echo "$(date '+%Y-%m-%dT%H:%M:%S.%6N%:z') restarting consumer for queue ${QUEUE_NAME}"
done
